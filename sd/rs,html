    <script>
        // Mobile Menu Toggle
        function toggleMenu() {
            document.getElementById('navLinks').classList.toggle('active');
        }

        // Navbar scroll effect
        window.addEventListener('scroll', function() {
            const navbar = document.getElementById('navbar');
            const scrollTop = document.getElementById('scrollTop');
            
            if (window.scrollY > 50) {
                navbar.classList.add('scrolled');
            } else {
                navbar.classList.remove('scrolled');
            }

            if (window.scrollY > 300) {
                scrollTop.classList.add('visible');
            } else {
                scrollTop.classList.remove('visible');
            }
        });

        // Smooth scroll for nav links
        document.querySelectorAll('.nav-links a').forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
                document.getElementById('navLinks').classList.remove('active');
            });
        });

        // Animate on scroll
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver(function(entries) {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('animated');
                    
                    // Animate skill bars if inside
                    const skillBars = entry.target.querySelectorAll('.skill-progress');
                    skillBars.forEach(bar => {
                        const width = bar.getAttribute('data-width');
                        setTimeout(() => {
                            bar.style.width = width + '%';
                        }, 200);
                    });
                }
            });
        }, observerOptions);

        document.querySelectorAll('.animate-on-scroll').forEach(el => {
            observer.observe(el);
        });

        // Send message via WhatsApp
        function sendMessage() {
            const name = document.getElementById('formName').value;
            const phone = document.getElementById('formPhone').value;
            const subject = document.getElementById('formSubject').value;
            const message = document.getElementById('formMessage').value;

            let whatsappMessage = `Hello Saifullah Khan!%0A%0A`;
            if (name) whatsappMessage += `Name: ${name}%0A`;
            if (phone) whatsappMessage += `Phone: ${phone}%0A`;
            if (subject) whatsappMessage += `Subject: ${subject}%0A`;
            if (message) whatsappMessage += `Message: ${message}%0A`;

            window.open(`https://wa.me/923183895479?text=${whatsappMessage}`, '_blank');
        }

        // Typing effect for hero greeting
        const greeting = document.querySelector('.hero-greeting');
        if (greeting) {
            greeting.style.opacity = '0';
            greeting.style.transform = 'translateY(-10px)';
            setTimeout(() => {
                greeting.style.transition = 'all 0.8s ease';
                greeting.style.opacity = '1';
                greeting.style.transform = 'translateY(0)';
            }, 300);
        }

        // Parallax effect on blobs
        document.addEventListener('mousemove', (e) => {
            const blobs = document.querySelectorAll('.blob');
            const x = (e.clientX / window.innerWidth - 0.5) * 20;
            const y = (e.clientY / window.innerHeight - 0.5) * 20;
            
            blobs.forEach((blob, i) => {
                const speed = (i + 1) * 0.5;
                blob.style.transform = `translate(${x * speed}px, ${y * speed}px)`;
            });
        });
    </script>
